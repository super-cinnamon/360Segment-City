{
    "depth_estimation": {
        "mode": "marigold",
        "models": {
            "marigold": {
                "model_name": "prs-eth/marigold-lcm-v1-0",
                "pipeline_name": "marigold_depth_estimation",
                "hyperparameters": {
                    "denoising_steps": 4,
                    "ensemble_size": 5,
                    "processing_res": 768,
                    "match_input_res": true
                }
            },
            "yolo": {
                "model_name": "yolo26x-depth.pt"
            }
        }
    },
    "flow_estimation": {
        "model_name": "egorchistov/optical-flow-MEMFOF-Tartan-T-TSKH-kitti"
    },
    "segmentation": {
        "model_name": "shi-labs/oneformer_cityscapes_swin_large",
        "task": "panoptic",
        "id2label": {
            "0": "road",
            "1": "sidewalk",
            "2": "building",
            "3": "wall",
            "4": "fence",
            "5": "pole",
            "6": "traffic light",
            "7": "traffic sign",
            "8": "vegetation",
            "9": "terrain",
            "10": "sky",
            "11": "person",
            "12": "rider",
            "13": "car",
            "14": "truck",
            "15": "bus",
            "16": "train",
            "17": "motorcycle",
            "18": "bicycle"
        },
        "dynamic_labels": [
            11,
            12,
            13,
            14,
            15,
            17,
            18
        ],
        "static_labels": [
            1,
            3,
            4,
            5,
            6,
            7
        ],
        "score_threshold": 0.8,
        "depth_threshold": 0.3,
        "min_depth": {
            "back": 0.11,
            "front": 0.01,
            "sides": 0.08
        }
    },
    "agent_persistence": {
        "max_age_frames": 30,
        "score_floor": 0.2
    },
    "vlm": {
        "selected_model": "cosmos3-nano",
        "models": {
            "cosmos3-nano": {
                "label": "NVIDIA Cosmos 3 Nano",
                "repo_id": "nvidia/Cosmos3-Nano",
                "backend": "transformers",
                "supports_video": true,
                "load_options": {}
            },
            "qwen-3.8-27b-nvfp4": {
                "label": "Qwen 3.8 27B NVFP4",
                "repo_id": "unsloth/Qwen3.8-27B-NVFP4",
                "backend": "unsloth",
                "supports_video": true,
                "quantization": "nvfp4",
                "load_options": {}
            },
            "nemotron-3-nano-omni-30b-a3b-reasoning": {
                "label": "NVIDIA Nemotron 3 Nano Omni 30B A3B Reasoning (GGUF)",
                "repo_id": "unsloth/NVIDIA-Nemotron-3-Nano-Omni-30B-A3B-Reasoning-GGUF",
                "backend": "llama.cpp",
                "artifact_format": "gguf",
                "model_file": "NVIDIA-Nemotron-3-Nano-Omni-30B-A3B-Reasoning-UD-Q4_K_M.gguf",
                "mmproj_file": "mmproj-F16.gguf",
                "server_port": 5016,
                "context_size": 8192,
                "supports_video": true,
                "download_patterns": [
                    "NVIDIA-Nemotron-3-Nano-Omni-30B-A3B-Reasoning-UD-Q4_K_M.gguf",
                    "mmproj-F16.gguf"
                ],
                "load_options": {}
            },
            "gemma-4-12b": {
                "label": "Gemma 4 12B",
                "repo_id": "unsloth/gemma-4-12b-it-NVFP4",
                "backend": "unsloth",
                "supports_video": true,
                "quantization": "nvfp4",
                "load_options": {}
            },
            "gemma-4-26b-a4b": {
                "label": "Gemma 4 26B A4B",
                "repo_id": "unsloth/gemma-4-26B-A4B-it-NVFP4",
                "backend": "unsloth",
                "supports_video": true,
                "quantization": "nvfp4",
                "load_options": {}
            }
        },
        "ollama": {
            "model_name": "gemma4:e2b",
            "temperature": 0.7
        },
        "world_model": {
            "model_name": "nvidia/Cosmos3-Nano",
            "temperature": 0.5
        }
    },
    "processing": {
        "roi_enabled": true,
        "roi_threshold": 0.35,
        "image_scale": 0.4,
        "use_imu_telemetry": true,
        "prune_similar_frames": false,
        "frame_similarity_threshold": 2.0,
        "side_overlap": 0.1,
        "side_overlap_matching": {
            "min_coverage": 0.2,
            "min_pixels": 4
        }
    },
    "risk_assessment": {
        "api_base": "http://localhost:5015/v1",
        "model_name": "nvidia/Cosmos3-Nano",
        "epoch_window_size": 30,
        "n_reasons": 10,
        "normalize_scores": true,
        "risk_scoring_temperature": 0.5,
        "softmax_temperature": 0.7
    },
    "risk_map": {
        "model_name": "nvidia/Cosmos3-Nano",
        "weights": {
            "vlm": 0.4,
            "area": 0.2,
            "conf": 0.2,
            "depth": 0.2
        },
        "hyperparameters": {
            "kappa_a": 10.0,
            "eta_a": 0.05,
            "d_ref": 0.5
        },
        "prompt": "Identify all potential motorcycle hazards on the road. For each hazard, provide a risk score between 0 and 1 based on its immediate threat level and a brief description."
    },
    "fragment_merging": {
        "enabled": true,
        "mergeable_classes": ["person", "rider", "car", "truck", "bus", "motorcycle", "bicycle"],
        "max_gap_px": 40,
        "depth_rel_tol": 0.10,
        "vertical_overlap_min": 0.6,
        "max_merged_aspect_ratio": 3.0,
        "min_score": 0.6,
        "weights": {
            "proximity": 0.5,
            "depth_consistency": 0.3,
            "boundary_alignment": 0.2
        }
    },
    "yoloe": {
        "model_name": "yoloe-26x-seg.pt",
        "confidence_threshold": 0.25,
        "iou_threshold_merge": 0.9,
        "iou_threshold_associate": 0.5,
        "risk_boost_factor": 1.2
    },
    "vlm_hazard_identification": {
        "model_name": "gemma-4-26b-a4b",
        "prompt_template": "src/tasks/prompts/hazard_identification.md"
    },
    "hazard_classes": {
        "environment_hazards": [
            "pothole", "wet road", "debris", "construction zone",
            "oil spill", "gravel", "railroad crossing", "speed bump",
            "faded lane marking", "sun glare", "standing water", "ice patch"
        ],
        "dynamic_agents": ["person", "rider", "car", "truck", "bus", "motorcycle", "bicycle"]
    }
}
